# Slipstream backend configuration.
#
# Copy this file to `.env` and edit it there — `.env` is auto-loaded on
# startup so you don't need to export variables in every shell. Real
# environment variables / PowerShell `$env:` assignments always win over
# `.env`, which makes it safe to commit `.env.example` but never `.env`.
#
#   copy backend\.env.example backend\.env
#   python run_server.py
#
# The backend reads the file relative to CWD, the `backend/` folder and the
# repo root (first one found wins).

# --- Network access --------------------------------------------------------
# Bind to all interfaces so other machines on your LAN can reach the API and
# (when SLIPSTREAM_STATIC is set) the web UI. Set 127.0.0.1 for local-only.
SLIPSTREAM_HOST=0.0.0.0

# HTTP port the backend listens on (default 8000).
SLIPSTREAM_PORT=8000

# Comma-separated browser origins allowed to call the API cross-origin. Only
# needed when the UI is served from another origin (e.g. a Vite dev server on
# another machine) instead of from the backend itself. Leave empty for
# same-origin only.
#SLIPSTREAM_CORS_ORIGINS=http://192.168.1.50:4173

# --- Data & solver paths ---------------------------------------------------
# Where run data lives (default: backend/data). OpenFOAM cannot handle
# spaces in the path, so keep it space-free.
#SLIPSTREAM_DATA_DIR=C:\path\to\slipstream\backend\data

# OpenFOAM wrapper. On Windows/Docker point this at the wrapper bundled here;
# on macOS it's found on PATH automatically.
#SLIPSTREAM_OPENFOAM=C:\path\to\slipstream\backend\scripts\openfoam.cmd

# Docker image used by the Windows OpenFOAM wrapper (default
# opencfd/openfoam-default:latest).
#SLIPSTREAM_DOCKER_IMAGE=opencfd/openfoam-default:latest

# Serve the built frontend (frontend/dist) from the backend too, so the whole
# web app is reachable over the network from a single URL:
#     cd frontend && npm run build
# Built automatically — if frontend/dist exists next to the backend, the UI is
# served without setting anything. Override with SLIPSTREAM_STATIC to point at
# a different build folder.
#SLIPSTREAM_STATIC=C:\path\to\slipstream\frontend\dist

# --- Tuning ----------------------------------------------------------------
# Case-matrix program cap (default 2000), read at import — restart to apply.
#SLIPSTREAM_MAX_PROGRAM_MEMBERS=2000
