# Vite dev-server configuration. Copy to `.env` to override (values shown are
# the defaults). The built app itself has no URLs configured — it talks to the
# API through relative `/api` paths, so it works over the network whichever
# host serves it.
#
# Bind address. `0.0.0.0` exposes the Vite dev server to your LAN (like the
# backend's SLIPSTREAM_HOST). Remember the /api proxy target must stay on the
# same machine unless you point VITE_API_TARGET at the backend's LAN address.
VITE_HOST=127.0.0.1

# Dev-server listen port.
VITE_PORT=4173

# Where the /api dev proxy forwards to (backend host:port).
VITE_API_TARGET=http://127.0.0.1:8000
