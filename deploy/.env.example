# Slipstream deployment settings (copy to `.env` next to docker-compose.yml).
#
#   cp deploy/.env.example .env
#
# Every value below is optional; the defaults in docker-compose.yml apply when
# a key is absent or commented out.

# Stable Compose project name: keeps the volume/network identity the same when
# the deployment directory is moved or renamed. Change it if you run more than
# one Slipstream stack on the same Docker host (also change
# SLIPSTREAM_CONTAINER_NAME, SLIPSTREAM_VOLUME_NAME and the host port).
COMPOSE_PROJECT_NAME=slipstream

# --- Network ---------------------------------------------------------------
# Host port that serves the web UI + API.
SLIPSTREAM_HTTP_PORT=8000
# Bind address: 0.0.0.0 = reachable from the LAN, 127.0.0.1 = local only.
SLIPSTREAM_BIND_ADDR=0.0.0.0

# --- Image -----------------------------------------------------------------
# Image name/tag loaded from the exported tarball. Rebuild/export with a new
# version and change this to upgrade.
#SLIPSTREAM_IMAGE=slipstream:0.2.0
#SLIPSTREAM_CONTAINER_NAME=slipstream

# --- Data ------------------------------------------------------------------
# Default: a Docker named volume called "slipstream-data".
# To keep run data in a host directory instead (recommended for backups),
# uncomment and use an absolute path:
#SLIPSTREAM_DATA_PATH=/srv/slipstream/data
#SLIPSTREAM_VOLUME_NAME=slipstream-data

# --- Solver capacity -------------------------------------------------------
# Each analysis uses 6 OpenFOAM MPI ranks. 2 workers ≈ 12 busy threads;
# use 1 on machines with 8 or fewer hardware threads.
#SLIPSTREAM_WORKERS=2

# Hard cap on the number of runs in one case-matrix program (default 2000).
#SLIPSTREAM_MAX_PROGRAM_MEMBERS=2000

# Shared memory for MPI (default 1 GB). Raise for fine meshes on big models.
#SLIPSTREAM_SHM_SIZE=1gb

# Browser origins allowed to call the API cross-origin. Only needed when the
# UI is hosted somewhere other than this container; leave empty otherwise.
#SLIPSTREAM_CORS_ORIGINS=http://192.168.1.50:8080

# --- Misc ------------------------------------------------------------------
TZ=Asia/Shanghai
